# Copy this file to ".env" and fill in the values.

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Calendar ICS links. Separate several calendars with commas.
#   Outlook: outlook.com > Settings > Calendar > Shared calendars > Publish a calendar >
#            pick the calendar, "Can view all details" > Publish > copy the ICS link
#   Google:  Calendar settings > (your calendar) > Integrate calendar > "Secret address in iCal format"
CALENDAR_ICS_URLS=

# ---------- Voice ----------
# Engine: elevenlabs (most human, needs a key below) or kokoro (offline, free).
# ElevenLabs falls back to Kokoro automatically if it's unavailable or out of credits.
JARVIS_TTS=elevenlabs

# elevenlabs.io > profile > API Keys. Then run elevenlabs.bat to pick or design a voice.
ELEVENLABS_API_KEY=
# Voice to use (elevenlabs.bat writes this for you). Default: "George", a premade British voice.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# eleven_flash_v2_5 = fastest (recommended for conversation). eleven_v4_turbo = more expressive,
# and performs sound cues like [sigh].
ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75

# Where Jarvis's voice plays: part of a device name (e.g. VG27AQ3A), empty = Windows default.
# Or just ask him: "Hey Jarvis, test the speakers" / "use speaker number 2".
JARVIS_OUTPUT_DEVICE=
# Mic Jarvis listens on: part of a device name, empty = Windows default.
# Pinning it stops a Bluetooth speaker's mic from taking over when it connects.
JARVIS_INPUT_DEVICE=

# Offline Kokoro voice: bm_george, bm_fable, bm_lewis, bm_daniel  (hear them with: run.bat --voices)
JARVIS_VOICE=bm_george
JARVIS_VOICE_SPEED=1.0

# ---------- Hearing ----------
# Optional: override the voice-lock threshold set by enroll.bat (lower = more lenient)
# VOICE_MATCH_THRESHOLD=0.72
# Wake word sensitivity: lower = triggers more easily (0.3-0.7)
# JARVIS_WAKE_THRESHOLD=0.5
# Speech recognition model (runs on your GPU): large-v3-turbo, distil-large-v3, small.en
# JARVIS_STT_MODEL=large-v3-turbo
# Names Whisper should expect, comma separated
# JARVIS_STT_HOTWORDS=Jarvis, Rocket Frontier, Roblox

# ---------- Other ----------
# Claude model for Jarvis's brain
# JARVIS_MODEL=claude-haiku-5-5
# Background jobs. Terminal tasks run Claude Code on your Claude login (subscription):
# sonnet, opus or haiku. The screen agent uses the API key: its model and effort.
# JARVIS_TERMINAL_MODEL=sonnet
# JARVIS_AGENT_MODEL=claude-sonnet-5-5
# JARVIS_AGENT_EFFORT=low

# The HUD opens at http://127.0.0.1:7777 when Jarvis starts. Set to off to disable.
JARVIS_HUD=on
# JARVIS_HUD_PORT=7777
