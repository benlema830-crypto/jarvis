# Copy this file to ".env" and fill in the values.

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Calendar > Settings > (your calendar) > Integrate calendar > "Secret address in iCal format"
# Separate several calendars with commas.
GOOGLE_CALENDAR_ICS_URL=

# Voice: bm_george, bm_fable, bm_lewis, bm_daniel  (hear them with: run.bat --voices)
JARVIS_VOICE=bm_george
JARVIS_VOICE_SPEED=1.0

# Optional: override the voice-lock threshold set by enroll.bat (lower = more lenient)
# VOICE_MATCH_THRESHOLD=0.72

# Voice engine: chatterbox (most human, uses GPU) or kokoro (instant, CPU). Chatterbox falls back to Kokoro if the GPU is busy.
JARVIS_TTS=chatterbox
# Voice sample Chatterbox speaks like (~10-20s clean speech). Use a voice you have the rights to.
JARVIS_VOICE_SAMPLE=voices/bm_george.wav

# The HUD opens at http://127.0.0.1:7777 when Jarvis starts. Set to off to disable.
JARVIS_HUD=on
# JARVIS_HUD_PORT=7777
